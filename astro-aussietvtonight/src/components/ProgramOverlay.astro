---
/**
 * ProgramOverlay component for Aussie TV Tonight
 * Complete modal overlay with:
 * 1. Watch Live (Guarda in diretta) button linking to official Australian BVOD stream (7plus, 9Now, 10 Play, iview, SBS On Demand)
 * 2. Add to Calendar / Save Reminder (Salva in rubrica / promemoria calendario Google & Apple iCal)
 * 3. Episode synopsis, category, ratings, and timing in selected Australian city.
 */
import { AU_LIVE_STREAMS, AU_CHANNEL_WEBSITES } from '../utils/channelStreams';
---

<div 
  id="program-modal" 
  class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div 
    class="bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl transform transition-transform duration-200 scale-95 flex flex-col max-h-[92vh]"
    id="program-modal-card"
  >
    <!-- Modal Image / Header -->
    <div class="relative h-48 bg-slate-850 overflow-hidden flex-shrink-0">
      <img 
        id="modal-image" 
        src="" 
        alt="" 
        class="w-full h-full object-cover hidden"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>

      <!-- Close Button -->
      <button 
        type="button" 
        onclick="closeProgramModal()"
        class="absolute top-4 right-4 bg-slate-950/70 hover:bg-slate-800 text-slate-300 hover:text-white w-9 h-9 rounded-full flex items-center justify-center border border-slate-700/60 transition-colors z-10"
        aria-label="Close modal"
      >
        ✕
      </button>

      <!-- Channel badge in modal -->
      <div class="absolute bottom-4 left-6 flex items-center gap-3">
        <div class="w-10 h-8 bg-slate-950/80 rounded-lg p-1 flex items-center justify-center border border-slate-700/60">
          <img id="modal-channel-logo" src="" alt="" class="max-w-full max-h-full object-contain" />
        </div>
        <span id="modal-channel-name" class="font-bold text-white text-sm drop-shadow"></span>
      </div>
    </div>

    <!-- Modal Content -->
    <div class="p-6 overflow-y-auto flex-1 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span id="modal-time" class="text-xs font-mono font-bold bg-amber-400 text-slate-950 px-2 py-0.5 rounded">
            --:--
          </span>
          <span id="modal-rating" class="text-xs font-semibold text-slate-300 bg-slate-800 px-2 py-0.5 rounded hidden">
          </span>
          <span id="modal-category" class="text-xs text-slate-400 font-medium">
          </span>
        </div>

        <h3 id="modal-title" class="text-2xl font-extrabold text-white mb-3">
        </h3>

        <p id="modal-description" class="text-sm text-slate-300 leading-relaxed max-h-40 overflow-y-auto pr-1">
        </p>
      </div>

      <!-- Action Buttons: Watch Live + Add to Calendar -->
      <div class="mt-6 pt-4 border-t border-slate-800 space-y-3">
        <div class="flex items-center gap-3">
          <!-- Watch Live (Guarda in diretta) -->
          <a 
            id="modal-watch-live-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-red-600 hover:bg-red-500 active:bg-red-700 text-white font-bold rounded-2xl transition-colors text-sm shadow-md group"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-white animate-pulse"></span>
            <span id="modal-watch-label">Watch Live TV</span>
            <span class="text-xs opacity-75 group-hover:translate-x-0.5 transition-transform">↗</span>
          </a>

          <!-- Add to Calendar (Salva in rubrica / promemoria) -->
          <button 
            type="button"
            id="modal-calendar-btn"
            onclick="handleAddToCalendar()"
            class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-100 font-bold rounded-2xl border border-slate-700 transition-colors text-sm"
          >
            <span>📅</span>
            <span id="modal-cal-label">Set Reminder</span>
          </button>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium px-1">
          <span>Aussie TV Tonight • Official Freeview Stream</span>
          <button 
            type="button"
            onclick="closeProgramModal()"
            class="hover:text-slate-400 transition-colors"
          >
            Dismiss
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const STREAMS_DATA = {
    'seven': 'https://7plus.com.au/live-tv',
    '7two': 'https://7plus.com.au/live-tv?channel-id=7Two',
    '7mate': 'https://7plus.com.au/live-tv?channel-id=7mate',
    '7flix': 'https://7plus.com.au/live-tv?channel-id=7flix',
    'channel-9': 'https://www.9now.com.au/live/channel-9',
    '9gem': 'https://www.9now.com.au/live/9gem',
    '9go': 'https://www.9now.com.au/live/9go',
    '9life': 'https://www.9now.com.au/live/9life',
    '9rush': 'https://www.9now.com.au/live/9rush',
    '10': 'https://10play.com.au/live/ten',
    '10-drama': 'https://10play.com.au/live/bold',
    '10-comedy': 'https://10play.com.au/live/peach',
    'nickelodeon': 'https://10play.com.au/live/nickelodeon',
    'abc-tv': 'https://iview.abc.net.au/channel/abctv',
    'abc-kids': 'https://iview.abc.net.au/channel/abckids',
    'abc-tv-plus': 'https://iview.abc.net.au/channel/abctvplus',
    'abc-entertains': 'https://iview.abc.net.au/channel/abcme',
    'abc-news': 'https://iview.abc.net.au/channel/news24',
    'sbs': 'https://www.sbs.com.au/ondemand/live/sbs',
    'sbs-viceland': 'https://www.sbs.com.au/ondemand/live/sbs-viceland',
    'sbs-world-movies': 'https://www.sbs.com.au/ondemand/live/sbs-world-movies',
    'sbs-food': 'https://www.sbs.com.au/ondemand/live/sbs-food',
    'nitv': 'https://www.sbs.com.au/ondemand/live/nitv'
  };

  const WEBSITES_DATA = {
    'seven': 'https://7plus.com.au',
    'channel-9': 'https://www.9now.com.au',
    '10': 'https://10play.com.au',
    'abc-tv': 'https://iview.abc.net.au',
    'sbs': 'https://www.sbs.com.au/ondemand'
  };

  let activeProgram = null;

  function openProgramModal(el) {
    const modal = document.getElementById('program-modal');
    const card = document.getElementById('program-modal-card');
    if (!modal) return;

    const channelSlug = el.getAttribute('data-channel-slug') || '';
    const title = el.getAttribute('data-title') || '';
    const desc = el.getAttribute('data-desc') || 'No description available.';
    const cat = el.getAttribute('data-category') || '';
    const rating = el.getAttribute('data-rating') || '';
    const startIso = el.getAttribute('data-start') || '';
    const endIso = el.getAttribute('data-end') || '';
    const img = el.getAttribute('data-image') || '';
    const chName = el.getAttribute('data-channel-name') || '';
    const chLogo = el.getAttribute('data-channel-logo') || '';

    activeProgram = { channelSlug, title, desc, cat, startIso, endIso, chName, chLogo };

    document.getElementById('modal-title').textContent = title;
    document.getElementById('modal-description').textContent = desc;
    document.getElementById('modal-category').textContent = cat;

    const ratingEl = document.getElementById('modal-rating');
    if (rating) {
      ratingEl.textContent = rating;
      ratingEl.classList.remove('hidden');
    } else {
      ratingEl.classList.add('hidden');
    }

    const imgEl = document.getElementById('modal-image');
    if (img) {
      imgEl.src = img;
      imgEl.classList.remove('hidden');
    } else {
      imgEl.classList.add('hidden');
    }

    document.getElementById('modal-channel-name').textContent = chName;
    document.getElementById('modal-channel-logo').src = chLogo;

    // Stream / Watch live configuration
    const watchBtn = document.getElementById('modal-watch-live-btn');
    const watchLabel = document.getElementById('modal-watch-label');
    const streamUrl = STREAMS_DATA[channelSlug] || WEBSITES_DATA[channelSlug];

    if (streamUrl) {
      watchBtn.href = streamUrl;
      watchBtn.classList.remove('hidden');
      watchLabel.textContent = `Watch on ${chName}`;
    } else {
      watchBtn.classList.add('hidden');
    }

    // Time in active Australian city
    const savedCity = localStorage.getItem('aussie_city') || 'sydney';
    const TIMEZONE_MAP = {
      'sydney': 'Australia/Sydney',
      'melbourne': 'Australia/Melbourne',
      'brisbane': 'Australia/Brisbane',
      'adelaide': 'Australia/Adelaide',
      'perth': 'Australia/Perth'
    };
    const tz = TIMEZONE_MAP[savedCity] || 'Australia/Sydney';

    try {
      const dStart = new Date(startIso);
      const startFmt = new Intl.DateTimeFormat('en-AU', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(dStart);
      let endFmt = '';
      if (endIso) {
        const dEnd = new Date(endIso);
        endFmt = ' - ' + new Intl.DateTimeFormat('en-AU', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(dEnd);
      }
      document.getElementById('modal-time').textContent = startFmt + endFmt;
    } catch (e) {
      document.getElementById('modal-time').textContent = '--:--';
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeProgramModal() {
    const modal = document.getElementById('program-modal');
    const card = document.getElementById('program-modal-card');
    if (!modal) return;
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 150);
  }

  function handleAddToCalendar() {
    if (!activeProgram) return;

    const prog = activeProgram;
    const startUtc = new Date(prog.startIso).toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z');
    const endUtc = prog.endIso 
      ? new Date(prog.endIso).toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z')
      : startUtc;

    const streamUrl = STREAMS_DATA[prog.channelSlug] || `https://aussietvtonight.com/${prog.channelSlug}/`;
    const details = `${prog.title} on ${prog.chName}\n\n${prog.desc}\n\nWatch Live: ${streamUrl}\nAussie TV Tonight: https://aussietvtonight.com/`;

    const isChrome = /Chrome\//.test(navigator.userAgent) && !/Edg\/|OPR\/|SamsungBrowser/.test(navigator.userAgent);

    if (isChrome) {
      // Direct Google Calendar Add
      const params = new URLSearchParams({
        action: 'TEMPLATE',
        text: prog.title,
        dates: `${startUtc}/${endUtc}`,
        details: details,
        location: streamUrl,
      });
      window.open(`https://calendar.google.com/calendar/render?${params}`, '_blank', 'noopener,noreferrer');
    } else {
      // Download Apple / standard iCal (.ics)
      const icsData = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//AussieTVTonight//AU',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        `UID:${Date.now()}@aussietvtonight.com`,
        `DTSTAMP:${startUtc}`,
        `DTSTART:${startUtc}`,
        `DTEND:${endUtc}`,
        `SUMMARY:${prog.title}`,
        `DESCRIPTION:${details.replace(/\n/g, '\\n')}`,
        `LOCATION:${streamUrl}`,
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${prog.title.replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '_').toLowerCase()}.ics`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    }

    const label = document.getElementById('modal-cal-label');
    if (label) {
      label.textContent = '✓ Reminder Set!';
      setTimeout(() => {
        label.textContent = 'Set Reminder';
      }, 2500);
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProgramModal();
  });
</script>
