---
/**
 * ProgramOverlay component for Aussie TV Tonight
 * Clean modal overlay with show details, synopsis, category, timing.
 */
---

<div 
  id="program-modal" 
  class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div 
    class="bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl transform transition-transform duration-200 scale-95"
    id="program-modal-card"
  >
    <!-- Modal Image / Header -->
    <div class="relative h-48 bg-slate-850 overflow-hidden">
      <img 
        id="modal-image" 
        src="" 
        alt="" 
        class="w-full h-full object-cover hidden"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>

      <!-- Close Button -->
      <button 
        type="button" 
        onclick="closeProgramModal()"
        class="absolute top-4 right-4 bg-slate-950/70 hover:bg-slate-800 text-slate-300 hover:text-white w-9 h-9 rounded-full flex items-center justify-center border border-slate-700/60 transition-colors"
        aria-label="Close modal"
      >
        ✕
      </button>

      <!-- Channel badge in modal -->
      <div class="absolute bottom-4 left-6 flex items-center gap-3">
        <div class="w-10 h-8 bg-slate-950/80 rounded-lg p-1 flex items-center justify-center border border-slate-700/60">
          <img id="modal-channel-logo" src="" alt="" class="max-w-full max-h-full object-contain" />
        </div>
        <span id="modal-channel-name" class="font-bold text-white text-sm drop-shadow"></span>
      </div>
    </div>

    <!-- Modal Content -->
    <div class="p-6">
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <span id="modal-time" class="text-xs font-mono font-bold bg-amber-400 text-slate-950 px-2 py-0.5 rounded">
          --:--
        </span>
        <span id="modal-rating" class="text-xs font-semibold text-slate-300 bg-slate-800 px-2 py-0.5 rounded hidden">
        </span>
        <span id="modal-category" class="text-xs text-slate-400 font-medium">
        </span>
      </div>

      <h3 id="modal-title" class="text-2xl font-extrabold text-white mb-3">
      </h3>

      <p id="modal-description" class="text-sm text-slate-300 leading-relaxed max-h-48 overflow-y-auto pr-1">
      </p>

      <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
        <span class="text-xs text-slate-500 font-medium">Aussie TV Tonight • Freeview</span>
        <button 
          type="button"
          onclick="closeProgramModal()"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-bold transition-colors"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function openProgramModal(el) {
    const modal = document.getElementById('program-modal');
    const card = document.getElementById('program-modal-card');
    if (!modal) return;

    const title = el.getAttribute('data-title') || '';
    const desc = el.getAttribute('data-desc') || 'No description available.';
    const cat = el.getAttribute('data-category') || '';
    const rating = el.getAttribute('data-rating') || '';
    const startIso = el.getAttribute('data-start') || '';
    const endIso = el.getAttribute('data-end') || '';
    const img = el.getAttribute('data-image') || '';
    const chName = el.getAttribute('data-channel-name') || '';
    const chLogo = el.getAttribute('data-channel-logo') || '';

    document.getElementById('modal-title').textContent = title;
    document.getElementById('modal-description').textContent = desc;
    document.getElementById('modal-category').textContent = cat;

    const ratingEl = document.getElementById('modal-rating');
    if (rating) {
      ratingEl.textContent = rating;
      ratingEl.classList.remove('hidden');
    } else {
      ratingEl.classList.add('hidden');
    }

    const imgEl = document.getElementById('modal-image');
    if (img) {
      imgEl.src = img;
      imgEl.classList.remove('hidden');
    } else {
      imgEl.classList.add('hidden');
    }

    document.getElementById('modal-channel-name').textContent = chName;
    document.getElementById('modal-channel-logo').src = chLogo;

    // Time in active city
    const savedCity = localStorage.getItem('aussie_city') || 'sydney';
    const TIMEZONE_MAP = {
      'sydney': 'Australia/Sydney',
      'melbourne': 'Australia/Melbourne',
      'brisbane': 'Australia/Brisbane',
      'adelaide': 'Australia/Adelaide',
      'perth': 'Australia/Perth'
    };
    const tz = TIMEZONE_MAP[savedCity] || 'Australia/Sydney';

    try {
      const dStart = new Date(startIso);
      const startFmt = new Intl.DateTimeFormat('en-AU', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(dStart);
      let endFmt = '';
      if (endIso) {
        const dEnd = new Date(endIso);
        endFmt = ' - ' + new Intl.DateTimeFormat('en-AU', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(dEnd);
      }
      document.getElementById('modal-time').textContent = startFmt + endFmt;
    } catch (e) {
      document.getElementById('modal-time').textContent = '--:--';
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeProgramModal() {
    const modal = document.getElementById('program-modal');
    const card = document.getElementById('program-modal-card');
    if (!modal) return;
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 150);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProgramModal();
  });
</script>
