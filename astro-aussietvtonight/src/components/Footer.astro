---
/**
 * Footer component for Aussie TV Tonight
 */
const currentYear = new Date().getFullYear();

const INTERNATIONAL_SITES = [
  { name: 'inTVstasera.it', flag: '🇮🇹', url: 'https://www.intvstasera.it/' },
  { name: 'ProgrammeCeSoir.fr', flag: '🇫🇷', url: 'https://programmecesoir.fr/' },
  { name: 'FernsehHeute.de', flag: '🇩🇪', url: 'https://fernsehheute.de/' },
  { name: 'UKTVTonight.co.uk', flag: '🇬🇧', url: 'https://uktvtonight.co.uk/' },
  { name: 'TeleEstaNoche.es', flag: '🇪🇸', url: 'https://www.teleestanoche.es/' },
  { name: 'TVWieczor.pl', flag: '🇵🇱', url: 'https://tvwieczor.pl/' },
];
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🇦🇺</span>
          <span class="text-lg font-bold text-white tracking-tight">
            Aussie TV <span class="text-amber-400">Tonight</span>
          </span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md mb-4">
          Australia's fastest Freeview TV guide. Find out what's on TV tonight across Sydney, Melbourne, Brisbane, Adelaide, and Perth with zero lag, instant Prime Time schedules, and real-time listings.
        </p>
        <p class="text-xs text-slate-500">
          Covering Seven, Channel 9, 10, ABC TV, SBS, and all digital multi-channels.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">TV Guide Tonight</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-amber-400 transition-colors">🌙 Tonight on TV (7:30 PM)</a></li>
          <li><a href="/on-now/" class="hover:text-amber-400 transition-colors">🔴 What's on TV Right Now</a></li>
          <li><a href="/movies-tonight/" class="hover:text-amber-400 transition-colors">🍿 Movies on TV Tonight</a></li>
          <li><a href="/sport-tonight/" class="hover:text-amber-400 transition-colors">🏉 Sport on TV Tonight</a></li>
          <li><a href="/shows-tonight/" class="hover:text-amber-400 transition-colors">📺 TV Shows Tonight</a></li>
          <li><a href="/tomorrow/" class="hover:text-amber-400 transition-colors">📅 Tomorrow's TV Guide</a></li>
        </ul>
      </div>

      <!-- Networks & Information -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">Networks & Freeview</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/seven/" class="hover:text-amber-400 transition-colors">Channel 7 (Seven)</a></li>
          <li><a href="/channel-9/" class="hover:text-amber-400 transition-colors">Channel 9 (Nine)</a></li>
          <li><a href="/10/" class="hover:text-amber-400 transition-colors">Network 10</a></li>
          <li><a href="/abc-tv/" class="hover:text-amber-400 transition-colors">ABC TV</a></li>
          <li><a href="/sbs/" class="hover:text-amber-400 transition-colors">SBS Australia</a></li>
        </ul>
      </div>

    </div>

    <!-- International TV Guides -->
    <div class="mb-8 pt-6 border-t border-slate-900">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">International TV Guides</h4>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs" aria-label="International TV Guides">
        {INTERNATIONAL_SITES.map(site => (
          <a href={site.url} class="inline-flex items-center gap-1.5 hover:text-amber-400 transition-colors">
            <span>{site.flag}</span>
            <span>{site.name}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-850 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} aussietvtonight.com — All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy/" class="hover:text-slate-400 transition-colors">Privacy & Cookie Policy</a>
        <a href="/terms/" class="hover:text-slate-400 transition-colors">Terms of Service</a>
        <a href="mailto:tv@aussietvtonight.com" class="hover:text-amber-400 transition-colors flex items-center gap-1">
          <span>✉️</span> tv@aussietvtonight.com
        </a>
      </div>
    </div>
  </div>
</footer>
