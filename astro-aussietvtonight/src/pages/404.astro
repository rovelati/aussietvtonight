---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Page Not Found | Aussie TV Tonight";
const pageDesc = "404 - The page you are looking for does not exist.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header />
  <main class="flex-1 max-w-xl mx-auto px-4 py-24 text-center">
    <span class="text-6xl mb-4 block">📺</span>
    <h1 class="text-4xl font-extrabold text-white mb-3">404 - Not Found</h1>
    <p class="text-slate-400 mb-8 text-sm">
      The channel or guide page you requested cannot be found or has moved.
    </p>
    <a 
      href="/" 
      class="px-6 py-3 rounded-xl bg-amber-400 text-slate-950 font-bold hover:bg-amber-300 transition-colors inline-block"
    >
      Return to Tonight's TV Guide
    </a>
  </main>
  <Footer />
</BaseLayout>
