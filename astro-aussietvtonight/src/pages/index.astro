---
/**
 * Homepage — Aussie TV Tonight (Prime Time 7:30 PM)
 * Fast, instant TV guide for Australia.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInAustralia, formatDateAU, getAustralianHour } from '../utils/timeSlots';
import { normCid } from '../utils/channelSlug';
import { MAJOR_AU_ORDER, filterRealPrograms } from '../utils/channelFilters';
import type { Channel, Program } from '../types';

const today = getTodayInAustralia();
const dateLabel = formatDateAU(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length < 2) continue;

    // Filter Prime Time (from 19:00 / 19:30 onwards in Sydney/Eastern time)
    const eveningPrograms = realChPrograms
      .filter(p => {
        const hour = getAustralianHour(p.start_time, 'Australia/Sydney');
        // Programs in prime time window (after 19:00 or late night up to 2:00)
        return hour >= 19 || hour <= 2;
      })
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug });
    }
  }

  // Sort channels by Major Australian priority order
  channelsWithPrograms.sort((a, b) => {
    const ai = MAJOR_AU_ORDER.indexOf(a.slug);
    const bi = MAJOR_AU_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return (a.number || 99) - (b.number || 99);
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch (err) {
  console.error('[index.astro] Error rendering homepage:', err);
}

const pageTitle = "What's on TV Tonight | Freeview TV Guide Australia";
const pageDesc = "Complete Australian TV guide for tonight. Discover prime time shows starting at 7:30 PM, movies, and current affairs on Channel 7, Nine, 10, ABC, and SBS.";
const keywords = "what's on tv tonight, tv guide tonight, freeview tv guide, on tv tonight, tonight on tv, free to air tv guide tonight australia, aussie tv guide";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TVGuide",
  "name": "Aussie TV Tonight",
  "url": "https://www.aussietvtonight.com/",
  "description": pageDesc,
  "inLanguage": "en-AU",
  "spatialCoverage": {
    "@type": "Country",
    "name": "Australia",
    "identifier": "AU"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Australia",
    "identifier": "AU"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Aussie TV Tonight",
    "url": "https://www.aussietvtonight.com",
    "logo": "https://www.aussietvtonight.com/icon-512.png",
    "areaServed": {
      "@type": "Country",
      "name": "Australia"
    }
  }
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What time does prime time start on Australian television?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prime time in Australia traditionally begins at 7:30 PM across all major networks, featuring marquee reality franchises (such as Married at First Sight, MasterChef Australia, The Block, and Australian Survivor), premium dramas, and investigative journalism."
      }
    },
    {
      "@type": "Question",
      "name": "Is Australian Freeview television free to watch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100% free. Freeview encompasses all terrestrial digital broadcast channels across Australia. Commercial networks (Seven, Nine, 10) are funded through broadcast advertising, while public networks (ABC, SBS) are funded by the Australian Federal Government."
      }
    },
    {
      "@type": "Question",
      "name": "How do I switch timezones on Aussie TV Tonight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the City Selector in the top navigation bar to choose your location (Sydney, Melbourne, Brisbane, Adelaide, or Perth). Every schedule time automatically recalculates to your local wall-clock time."
      }
    },
    {
      "@type": "Question",
      "name": "Can I watch live Freeview TV on my phone or smart TV?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Clicking any program on Aussie TV Tonight opens a direct shortcut to the broadcaster's official BVOD streaming platform (7plus, 9Now, 10 Play, ABC iview, SBS On Demand), where live television can be streamed legally and free of charge."
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={[jsonLd, faqJsonLd]}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero Section -->
    <div class="mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-800 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold mb-3">
            <span>✨ Australia's #1 Freeview Guide</span>
            <span>•</span>
            <span>{dateLabel}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            What's on TV <span class="text-amber-400">Tonight</span>
          </h1>
          <p class="text-base text-slate-400 mt-2 max-w-2xl">
            Prime Time Freeview guide starting at <strong>7:30 PM</strong> across Channel 7, Nine, 10, ABC, SBS, and digital multi-channels.
          </p>
        </div>

        <!-- Quick Filters -->
        <div class="flex items-center gap-2">
          <a 
            href="/movies-tonight/" 
            class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-2 shadow-sm"
          >
            🍿 Movies Tonight
          </a>
          <a 
            href="/on-now/" 
            class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-2 shadow-sm"
          >
            🔴 On Now
          </a>
        </div>
      </div>
    </div>

    <!-- Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {channelsWithPrograms.map(ch => (
        <ChannelCard channel={ch} programs={ch.programs} slug={ch.slug} />
      ))}
    </div>

    <!-- Editorial & Freeview Guide Section -->
    <section class="mt-16 pt-12 border-t border-slate-800 space-y-12">
      
      <!-- Section 1: Overview & Networks -->
      <div class="bg-slate-900/60 p-6 sm:p-8 rounded-3xl border border-slate-800">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-2">Australian Free-to-Air Television Guide</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
          How Freeview Prime Time Works
        </h2>
        <div class="prose prose-invert prose-slate max-w-none text-slate-300 text-sm sm:text-base space-y-4 leading-relaxed">
          <p>
            In Australia, free-to-air television is organized under the <strong>Freeview</strong> platform, offering dozens of digital channels without any subscription fee. Prime time scheduling traditionally centers around <strong>7:30 PM</strong>, immediately following the flagship 6:00 PM nightly news bulletins and current affairs programs (such as <em>A Current Affair</em> on Nine and <em>7.30</em> on the ABC).
          </p>
          <p>
            The major free-to-air broadcast networks include two national public broadcasters (<strong>ABC</strong> and multicultural broadcaster <strong>SBS</strong>) and three primary commercial networks (<strong>Seven Network</strong>, <strong>Nine Network</strong>, and <strong>Network 10</strong>). In addition to their main high-definition channels, each broadcaster operates multiple digital multi-channels tailored to specific viewer interests—ranging from British drama on 9Gem and action reality on 7mate to classic sitcoms on 10 Peach and world cinema on SBS World Movies.
          </p>
        </div>
      </div>

      <!-- Section 2: Timezone Guide -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
          <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
            <span>🕒</span> Australian Time Zones Explained
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
            Because Australia spans five distinct standard and daylight-saving time zones during the summer months, identical programs may broadcast at different local times:
          </p>
          <ul class="text-xs text-slate-400 space-y-2">
            <li><strong>AEDT (UTC+11):</strong> Sydney, Melbourne, Canberra, Hobart.</li>
            <li><strong>AEST (UTC+10):</strong> Brisbane (Queensland does not observe daylight saving).</li>
            <li><strong>ACDT (UTC+10:30):</strong> Adelaide and regional South Australia.</li>
            <li><strong>ACST (UTC+9:30):</strong> Darwin and Northern Territory.</li>
            <li><strong>AWST (UTC+8):</strong> Perth and Western Australia.</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
          <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
            <span>📱</span> Watch Live & Catch-Up on BVOD
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
            Missed an episode or don't have an aerial connection? Every major Australian network offers a free Broadcaster Video on Demand (BVOD) app with live streaming and catch-up:
          </p>
          <ul class="text-xs text-slate-400 space-y-2">
            <li><strong>7plus:</strong> Live streams for Channel 7, 7two, 7mate, 7flix, and 7Bravo.</li>
            <li><strong>9Now:</strong> Live streams for Channel 9, 9Gem, 9Go!, 9Life, and 9Rush.</li>
            <li><strong>10 Play:</strong> Live streams for Channel 10, 10 Bold, 10 Peach, and Nickelodeon.</li>
            <li><strong>ABC iview:</strong> On-demand & live broadcast of ABC TV, Kids, and ABC NEWS.</li>
            <li><strong>SBS On Demand:</strong> World movies, foreign language series, and documentaries.</li>
          </ul>
        </div>
      </div>

      <!-- Section 3: FAQ Accordion -->
      <div class="bg-slate-900/40 p-6 sm:p-8 rounded-3xl border border-slate-800">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <span>❓</span> Frequently Asked Questions (FAQ)
        </h2>
        <div class="space-y-4">
          <details class="group bg-slate-900/80 rounded-xl p-4 border border-slate-800 cursor-pointer" open>
            <summary class="font-semibold text-white text-sm sm:text-base flex justify-between items-center select-none">
              <span>What time does prime time start on Australian television?</span>
              <span class="text-amber-400 transition-transform group-open:rotate-180">▾</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-400 mt-3 leading-relaxed">
              Prime time in Australia traditionally begins at 7:30 PM across all major networks, featuring marquee reality franchises (such as Married at First Sight, MasterChef Australia, The Block, and Australian Survivor), premium dramas, and investigative journalism. The prime time window concludes around 10:30 PM.
            </p>
          </details>

          <details class="group bg-slate-900/80 rounded-xl p-4 border border-slate-800 cursor-pointer">
            <summary class="font-semibold text-white text-sm sm:text-base flex justify-between items-center select-none">
              <span>Is Australian Freeview television free to watch?</span>
              <span class="text-amber-400 transition-transform group-open:rotate-180">▾</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-400 mt-3 leading-relaxed">
              Yes, 100% free. Freeview encompasses all terrestrial digital broadcast channels across Australia. Commercial networks (Seven, Nine, 10) are funded through broadcast advertising, while public networks (ABC, SBS) are funded by the Australian Federal Government and selective sponsorships.
            </p>
          </details>

          <details class="group bg-slate-900/80 rounded-xl p-4 border border-slate-800 cursor-pointer">
            <summary class="font-semibold text-white text-sm sm:text-base flex justify-between items-center select-none">
              <span>How do I switch timezones on Aussie TV Tonight?</span>
              <span class="text-amber-400 transition-transform group-open:rotate-180">▾</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-400 mt-3 leading-relaxed">
              Use the City Selector in the top navigation bar to choose your location (Sydney, Melbourne, Brisbane, Adelaide, or Perth). Every schedule time automatically recalculates to your local wall-clock time without cookies or tracking.
            </p>
          </details>

          <details class="group bg-slate-900/80 rounded-xl p-4 border border-slate-800 cursor-pointer">
            <summary class="font-semibold text-white text-sm sm:text-base flex justify-between items-center select-none">
              <span>Can I watch live Freeview TV on my phone or smart TV?</span>
              <span class="text-amber-400 transition-transform group-open:rotate-180">▾</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-400 mt-3 leading-relaxed">
              Yes. Clicking any program on Aussie TV Tonight opens a direct shortcut to the broadcaster's official BVOD streaming platform (7plus, 9Now, 10 Play, ABC iview, SBS On Demand), where live television can be streamed legally and free of charge.
            </p>
          </details>
        </div>
      </div>

    </section>

  </main>

  <ProgramOverlay />
  <Footer />
</BaseLayout>
