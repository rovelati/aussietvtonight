---
/**
 * Sport Tonight — Aussie TV Tonight
 * Highly searched queries: sport on tv tonight, live sport on tv tonight australia, afl on tv tonight, nrl on tv tonight
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInAustralia, formatDateAU, formatTimeAU, getAustralianHour } from '../utils/timeSlots';
import { normCid } from '../utils/channelSlug';
import { isSport } from '../utils/programClassifier';
import { getFallbackImageForProgram } from '../utils/programImages';
import type { Channel, Program } from '../types';

const today = getTodayInAustralia();
const dateLabel = formatDateAU(today);

interface SportListing {
  program: Program;
  channel: Channel;
  slug: string;
}

let sportsTonight: SportListing[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const channelMap = new Map<string, Channel>();
  for (const ch of channels) {
    channelMap.set(normCid(ch.id), ch);
  }

  for (const prog of allPrograms) {
    const slug = normCid(prog.channel_id ?? '');
    const ch = channelMap.get(slug);
    if (!ch) continue;

    // Evening and prime time hours in Australian time (17:00 to 03:00 next morning)
    const hour = getAustralianHour(prog.start_time, 'Australia/Sydney');
    const isEvening = hour >= 17 || hour <= 3;

    if (isEvening && isSport(prog.category, prog.title, prog.description)) {
      sportsTonight.push({
        program: prog,
        channel: ch,
        slug,
      });
    }
  }

  // Sort chronologically by start time
  sportsTonight.sort((a, b) => new Date(a.program.start_time).getTime() - new Date(b.program.start_time).getTime());
} catch (err) {
  console.error('[sport-tonight.astro] Error fetching sports listings:', err);
}

const pageTitle = "Live Sport on TV Tonight Australia | Freeview Sport Guide";
const pageDesc = "Find all live sport on TV tonight in Australia across Channel 7, 7mate, Nine, 9Gem, 10, and ABC. Full schedules for AFL, NRL, Cricket, Football, and Motorsport.";
const keywords = "sport on tv tonight, live sport on tv tonight australia, what sport is on tv tonight, freeview sport tonight, afl on tv tonight, nrl on tv tonight, cricket on tv tonight australia";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Live Sport on TV Tonight in Australia",
  "itemListElement": sportsTonight.slice(0, 10).map((s, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "BroadcastEvent",
      "name": s.program.title,
      "description": s.program.description,
      "startDate": s.program.start_time,
      "location": {
        "@type": "BroadcastService",
        "name": s.channel.name
      }
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-400/10 border border-emerald-400/20 text-emerald-400 text-xs font-semibold mb-3">
          <span>🏉 Live Sport & Matches</span>
          <span>•</span>
          <span>{dateLabel}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Sport on TV <span class="text-emerald-400">Tonight</span> in Australia
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Live games, replays, and sports coverage airing tonight on Australian Freeview television ({sportsTonight.length} sporting events listed).
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a 
          href="/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors"
        >
          🌙 Tonight (7:30 PM)
        </a>
        <a 
          href="/movies-tonight/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors"
        >
          🍿 Movies Tonight
        </a>
        <a 
          href="/shows-tonight/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors"
        >
          📺 TV Shows
        </a>
      </div>
    </div>

    <!-- Sports Grid -->
    {sportsTonight.length === 0 ? (
      <div class="bg-slate-900 border border-slate-800 rounded-3xl p-12 text-center max-w-xl mx-auto my-12">
        <span class="text-5xl mb-4 block">🏉</span>
        <h2 class="text-xl font-bold text-white mb-2">No Live Sport Broadcasts Tonight</h2>
        <p class="text-sm text-slate-400 mb-6">
          There are no major sporting fixtures scheduled on free-to-air channels for this evening. Check out tonight's prime time shows and movies.
        </p>
        <div class="flex items-center justify-center gap-3">
          <a href="/" class="px-5 py-2.5 rounded-xl bg-amber-400 text-slate-950 font-bold text-sm hover:bg-amber-300 transition-colors">
            Tonight's Schedule →
          </a>
          <a href="/movies-tonight/" class="px-5 py-2.5 rounded-xl bg-slate-800 text-slate-200 font-bold text-sm hover:bg-slate-700 transition-colors">
            Movies Tonight
          </a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sportsTonight.map(({ program, channel, slug }) => {
          const timeFormatted = formatTimeAU(program.start_time);
          const endTimeFormatted = formatTimeAU(program.end_time);

          return (
            <div 
              class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all duration-200 shadow-lg flex flex-col group cursor-pointer"
              data-program-id={program.id}
              data-title={program.title}
              data-desc={program.description}
              data-category={program.category}
              data-start={program.start_time}
              data-end={program.end_time}
              data-rating={program.rating}
              data-image={program.image_url}
              data-channel-slug={slug}
              data-channel-name={channel.name}
              data-channel-logo={channel.logo}
              onclick="openProgramModal(this)"
            >
              {program.image_url && (
                <div class="w-full h-44 bg-slate-850 overflow-hidden relative">
                  <img 
                    src={program.image_url} 
                    alt={program.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    onerror={`this.onerror=null; this.src='${getFallbackImageForProgram(program.title, 'Sports')}';`}
                  />
                  <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur px-2.5 py-1 rounded-lg border border-slate-700/60 flex items-center gap-2">
                    <img src={channel.logo} alt={channel.name} class="h-4 max-w-[60px] object-contain" />
                    <span class="text-xs font-bold text-white">{channel.name}</span>
                  </div>
                  <div class="absolute top-3 right-3 bg-emerald-500/90 text-white font-bold text-xs px-2 py-0.5 rounded border border-emerald-400/40">
                    SPORT
                  </div>
                </div>
              )}

              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <span 
                        class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-emerald-400 text-slate-950"
                        data-utc-start={program.start_time}
                      >
                        {timeFormatted}
                      </span>
                      <span class="text-xs text-slate-500 font-medium">
                        until {endTimeFormatted}
                      </span>
                    </div>

                    <span class="text-xs text-slate-400 font-medium">
                      {channel.name}
                    </span>
                  </div>

                  <h2 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-1">
                    {program.title}
                  </h2>

                  <p class="text-xs text-slate-400 mt-2 line-clamp-3 leading-relaxed">
                    {program.description || 'Sports broadcast on Freeview Australia.'}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-semibold text-emerald-400">
                  <span>View Match Details →</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </main>

  <ProgramOverlay />
  <Footer />
</BaseLayout>
