---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Privacy Policy | Aussie TV Tonight";
const pageDesc = "Privacy policy for aussietvtonight.com - zero tracking cookies, local storage only.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header />
  <main class="flex-1 max-w-4xl mx-auto px-4 py-12 text-slate-300">
    <h1 class="text-3xl font-extrabold text-white mb-6">Privacy Policy</h1>
    <div class="space-y-4 text-sm leading-relaxed">
      <p>At <strong>aussietvtonight.com</strong>, we are committed to respecting your privacy. We do not use tracking cookies or require any personal accounts.</p>
      <h2 class="text-lg font-bold text-white mt-6">Local Storage</h2>
      <p>We store your selected Australian city and bookmarked channels locally on your browser using standard HTML5 Local Storage. This data never leaves your device.</p>
      <h2 class="text-lg font-bold text-white mt-6">Contact</h2>
      <p>For any queries, contact us at contact@aussietvtonight.com.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>
